parameters:
  paths:
  	# We consider that the extension file will be stored the folder test/phpstan
  	# From Phpstan 0.12, paths are relative to the .neon file.
    - %currentWorkingDirectory%/src
    - %currentWorkingDirectory%/kjblocks.php
  excludePaths:
    - %currentWorkingDirectory%/src/Grid/Position
  ignoreErrors:
    # Doctrine entity identifiers are populated by the ORM through reflection, so
    # PHPStan's "never written, only read" report is a false positive. On PS8 the
    # phpstan-doctrine extension suppressed it; that extension breaks on the PS9
    # EntityManager, so it is dropped and this scoped entry replaces it.
    -
      message: '#Property [a-zA-Z0-9\\_]+::\$id is never written, only read\.#'
      path: %currentWorkingDirectory%/src/Entity/*
      reportUnmatched: false
    # PrestaShop 9.0 declares LegacyContext::getContext() as @return Context, while
    # 9.1 declares @return Context|null. The null guards below are required for the
    # 9.1 signature; on 9.0 PHPStan sees them as "always false" dead code. Keeping
    # the guards is correct at runtime, so this scoped entry suppresses the 9.0-only
    # report (no-op on 9.1).
    -
      message: '#Strict comparison using === between Context and null will always evaluate to false\.#'
      paths:
        - %currentWorkingDirectory%/src/Block.php
        - %currentWorkingDirectory%/src/Form/DataHandler/BlockTypeFormDataHandler.php
        - %currentWorkingDirectory%/src/Form/DataProvider/BlockTypeFormDataProvider.php
      reportUnmatched: false
  reportUnmatchedIgnoredErrors: true
  level: 8

includes:
  - %currentWorkingDirectory%/tests/php/.phpstan_bootstrap.neon
  - %currentWorkingDirectory%/vendor/prestashop/php-dev-tools/phpstan/ps-module-extension.neon
